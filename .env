# TODO Application Environment Configuration

# =============================================================================
# SERVER PORTS
# =============================================================================
# Backend API server port
BACKEND_PORT=7035

# Frontend development server port
FRONTEND_PORT=7038

# CouchDB server port
COUCHDB_PORT=5984

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# CouchDB connection settings
COUCHDB_HOST=localhost
COUCHDB_USERNAME=root
COUCHDB_PASSWORD=root
COUCHDB_DATABASE=todo_tasks

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API base URL for frontend to connect to backend
API_BASE_URL=http://localhost:7035

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:7038,http://127.0.0.1:7038,http://localhost:7039,http://127.0.0.1:7039

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Application name and version
APP_NAME=Calendar-Integrated To-Do App
APP_VERSION=1.0.0

# Environment (development, production, testing)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
# Frontend build settings
FRONTEND_BUILD_OUTDIR=dist
FRONTEND_BUILD_SOURCEMAP=false
FRONTEND_BUILD_MINIFY=false
FRONTEND_BUILD_TARGET=es2015

# =============================================================================
# LOGGING
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# SECURITY
# =============================================================================
# Secret key for JWT tokens (if implemented later)
SECRET_KEY=your-secret-key-here-change-in-production

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_SOFT_DELETE=true
ENABLE_CALENDAR_VIEW=true
ENABLE_STATUS_TRACKING=true 
